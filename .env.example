# ==================================================
# RAG Pipeline — Environment Variables
# ==================================================
# Copy this file to .env and fill in required values.
# Only OPENAI_API_KEY is required; everything else has defaults.
# ==================================================

# === Required ===
OPENAI_API_KEY=sk-your-api-key-here

# === Application ===
# APP_NAME=RAG Pipeline
# APP_VERSION=1.0.0
# DEBUG=false
# LOG_LEVEL=INFO

# === API Server ===
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# RATE_LIMIT_PER_MINUTE=60

# === Model Configuration ===
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=100
# GENERATION_MODEL=gpt-4o
# RERANKER_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2000

# === Retrieval Tuning ===
# DEFAULT_TOP_K=5
# DENSE_TOP_K=10
# SPARSE_TOP_K=10
# FUSION_TOP_K=20
# RERANK_TOP_K=5
# RRF_K=60
# DENSE_WEIGHT=0.7
# SPARSE_WEIGHT=0.3
# DEFAULT_RETRIEVAL_MODE=hybrid

# === Chunking ===
# DEFAULT_CHUNK_SIZE=512
# DEFAULT_CHUNK_OVERLAP=50
# DEFAULT_CHUNKING_STRATEGY=recursive
# SEMANTIC_SIMILARITY_THRESHOLD=0.5

# === Deduplication ===
# DEDUP_SIMILARITY_THRESHOLD=0.95

# === Confidence Thresholds ===
# HIGH_CONFIDENCE_THRESHOLD=0.7
# LOW_CONFIDENCE_THRESHOLD=0.4

# === Storage Paths ===
# DATA_DIR=./data
# RAW_DOCS_DIR=./data/raw
# PROCESSED_DOCS_DIR=./data/processed
# CHROMA_PERSIST_DIR=./data/chroma_db
# CHROMA_COLLECTION_NAME=document_chunks
# BM25_INDEX_PATH=./data/indexes/bm25_index.pkl
# DOCUMENT_REGISTRY_PATH=./data/registry/documents.json

# === File Upload ===
# MAX_FILE_SIZE_MB=50
# ALLOWED_EXTENSIONS=[".md",".txt",".html",".htm",".pdf"]
